// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// --- NextAuth Models ---

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  currency      String    @default("₦")
  accounts      Account[]
  bankAccounts  BankStore[]
  sessions      Session[]
  
  defaultMonthlyBudget Float     @default(0) 
  yearlyBudget         Float     @default(0)
   
  transactions  Transaction[]
  budgets       Budget[]
  monthlyCaps   MonthlyCap[]   // Relation to history
}

model BankStore {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  monoAccountId     String   @unique // The ID from Mono
  institutionName   String   // e.g., "Kuda Bank"
  accountName       String?
  accountNumber     String?
  balance           Float    @default(0)
  currency          String   @default("NGN")
  lastSynced        DateTime @default(now())

  transactions    Transaction[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?
  balance           Float?   @default(0)
  institutionName   String?  // e.g., "Kuda Bank", "GTBank"
  lastSynced        DateTime? @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- Custom Budget App Models ---

model Transaction {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  amount      Float
  currency    String   @default("USD")
  category    String   
  description String?  
  date        DateTime @default(now())
  receiptUrl  String?
  receiptId   String?  

  bankAccountId   String?  @db.ObjectId 
  bankAccount     BankStore? @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MonthlyCap {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  month     Int      // 0 = Jan, 11 = Dec
  year      Int      // e.g. 2024
  amount    Float    // The limit for THIS specific month

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year]) // Prevent duplicate caps for same month
}

// ✅ UPDATED MODEL: Categories are now time-specific
model Budget {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  category  String
  limit     Float    
  period    String   @default("monthly")

  // Time Stamping
  month     Int      
  year      Int      

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Critical: Allows "Food" in Jan AND "Food" in Feb
  @@unique([userId, category, month, year]) 
}