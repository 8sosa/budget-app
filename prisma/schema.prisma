// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("NETLIFY_DB_URL") // set automatically by Netlify Database
}

// --- NextAuth Models ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  currency      String    @default("₦")
  accounts      Account[]
  sessions      Session[]

  defaultMonthlyBudget Decimal @default(0) @db.Decimal(14, 2)
  yearlyBudget         Decimal @default(0) @db.Decimal(14, 2)

  transactions    Transaction[]
  budgets         Budget[]
  bankConnections BankConnection[]
  monthlyCaps  MonthlyCap[] // Relation to history
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- Custom Budget App Models ---

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Decimal  @db.Decimal(14, 2)
  currency    String   @default("₦") // symbol of the user's currency when saved
  category    String
  description String?
  date        DateTime @default(now()) // calendar date, stored at 12:00 UTC
  receiptUrl  String?
  receiptId   String?
  type        String   @default("expense") // "expense" or "income"
  source      String   @default("manual") // "manual", or the bank a statement was imported from
  externalId  String? // fingerprint of an imported statement line, so re-imports skip it

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, externalId])
  @@index([userId, date])
}

model MonthlyCap {
  id     String  @id @default(cuid())
  userId String
  month  Int // 0 = Jan, 11 = Dec
  year   Int // e.g. 2024
  amount Decimal @db.Decimal(14, 2) // The limit for THIS specific month

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year]) // Prevent duplicate caps for same month
}

// ✅ UPDATED MODEL: Categories are now time-specific
model Budget {
  id       String  @id @default(cuid())
  userId   String
  category String
  limit    Decimal @db.Decimal(14, 2)
  period   String  @default("monthly")

  // Time Stamping
  month Int
  year  Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Critical: Allows "Food" in Jan AND "Food" in Feb
  @@unique([userId, category, month, year])
}

// A bank account linked through an open-banking provider (Mono), synced on demand
model BankConnection {
  id                String    @id @default(cuid())
  userId            String
  provider          String    @default("mono")
  providerAccountId String    @unique // Mono account id; doesn't expire unless unlinked
  institution       String? // e.g. "OPay", "Access Bank"
  accountName       String?
  accountNumber     String? // last 4 digits only
  lastSyncedAt      DateTime?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
