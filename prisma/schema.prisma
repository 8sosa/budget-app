// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// --- NextAuth Models (Required) ---

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  monthlyBudget Float     @default(0)
  
  // Relation to your custom data
  transactions  Transaction[]
  budgets       Budget[]
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- Your Custom Budget App Models ---

model Transaction {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  amount      Float
  currency    String   @default("USD")
  category    String   // e.g. "Food", "Transport"
  description String?  // e.g. "McDonalds Lunch"
  date        DateTime @default(now())
  
  // Receipt Data
  receiptUrl  String?
  receiptId   String?  // Cloudinary Public ID

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Budget {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  category    String
  limit       Float    // The spending cap
  period      String   @default("monthly") // monthly, weekly

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, category])
}
